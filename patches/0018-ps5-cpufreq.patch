diff --git a/drivers/ps5/ps5-cpufreq.c b/drivers/ps5/ps5-cpufreq.c
new file mode 100644
index 000000000..4efa4d404
--- /dev/null
+++ b/drivers/ps5/ps5-cpufreq.c
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PS5 CPU frequency driver.
+ *
+ * The PS5 ignores writes to the AMD P-state control MSR; core P-states are
+ * requested from the SMU (MP1) instead, with message 0x0B RequestCorePstate
+ * (found by MassZero0, github.com/MassZero0/ps5-linux-cpuclock).  The P-state
+ * table itself is read from the standard P-state definition MSRs:
+ * P0 3200, P1 2560, P2 2327, P3 1969, P4 1829, P5 1600, P6 1280, P7 800 MHz.
+ *
+ * One policy per physical core (both SMT threads).  Boost (SMU universal
+ * mode, up to 3.5 GHz) is the global cpufreq "boost" switch.  The SMU remaps
+ * core P-state requests while boost is on (P0/P1 -> 3.5 GHz, slower states
+ * -> ~1.55 GHz) and a P0 request drops it out of boost, so with boost on no
+ * P-state requests are sent: boost on = every core at full speed.  The
+ * governor's choices are kept and applied when boost goes off again.
+ */
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/module.h>
+#include <linux/topology.h>
+#include <linux/ps5.h>
+#include <asm/msr.h>
+#include <asm/processor.h>
+
+#define MSR_PSTATE_DEF_BASE	0xc0010064
+#define PS5_NUM_PSTATES		8
+#define PS5_NUM_CORES		8
+
+static struct cpufreq_frequency_table ps5_freq_table[PS5_NUM_PSTATES + 1];
+static unsigned int ps5_core_khz[PS5_NUM_CORES];
+static s8 ps5_core_want[PS5_NUM_CORES];	/* governor's P-state per core */
+static s8 ps5_core_sent[PS5_NUM_CORES];	/* last P-state sent, -1 unknown */
+static DEFINE_MUTEX(ps5_cpufreq_lock);
+
+static unsigned int pstate_khz(u64 def)
+{
+	u32 fid = def & 0xff;
+	u32 did = (def >> 8) & 0x3f;
+
+	if (!did)
+		return 0;
+	return fid * 200000U / did;
+}
+
+/* Caller holds ps5_cpufreq_lock, boost off. */
+static int ps5_send_pstate(unsigned int core, u8 pstate)
+{
+	int ret;
+
+	if (ps5_core_sent[core] == pstate)
+		return 0;
+	ret = ps5_mp1_request_core_pstate(BIT(core), pstate);
+	if (ret) {
+		pr_err_ratelimited("core %u -> P%u failed: %d\n", core, pstate, ret);
+		ps5_core_sent[core] = -1;
+		return ret;
+	}
+	ps5_core_sent[core] = pstate;
+	return 0;
+}
+
+/*
+ * Boost can also be switched through /dev/mp1 (ps5_control --boost): keep the
+ * cpufreq "boost" file showing the real state.
+ */
+static void ps5_sync_boost_flag(void);
+
+static int ps5_cpufreq_target_index(struct cpufreq_policy *policy, unsigned int index)
+{
+	unsigned int core = topology_core_id(policy->cpu);
+	u8 pstate = ps5_freq_table[index].driver_data;
+	int ret = 0;
+
+	if (core >= PS5_NUM_CORES)
+		return -EINVAL;
+
+	guard(mutex)(&ps5_cpufreq_lock);
+	ps5_sync_boost_flag();
+	ps5_core_want[core] = pstate;
+	if (!ps5_mp1_boost_enabled())
+		ret = ps5_send_pstate(core, pstate);
+	if (!ret)
+		ps5_core_khz[core] = ps5_freq_table[index].frequency;
+	return ret;
+}
+
+static unsigned int ps5_cpufreq_get(unsigned int cpu)
+{
+	unsigned int core = topology_core_id(cpu);
+
+	ps5_sync_boost_flag();
+
+	return core < PS5_NUM_CORES ? ps5_core_khz[core] : 0;
+}
+
+static int ps5_cpufreq_init(struct cpufreq_policy *policy)
+{
+	unsigned int core = topology_core_id(policy->cpu);
+
+	if (core >= PS5_NUM_CORES)
+		return -ENODEV;
+
+	cpumask_copy(policy->cpus, topology_sibling_cpumask(policy->cpu));
+	policy->freq_table = ps5_freq_table;
+	policy->cpuinfo.transition_latency = 200 * NSEC_PER_USEC;
+	/* Each change is an SMU mailbox message shared with the GPU: rate limit. */
+	policy->transition_delay_us = 10000;
+	policy->boost_supported = true;
+	if (!ps5_core_khz[core])
+		ps5_core_khz[core] = ps5_freq_table[0].frequency;
+	policy->cur = ps5_core_khz[core];
+	return 0;
+}
+
+static int ps5_cpufreq_set_boost(struct cpufreq_policy *policy, int state)
+{
+	unsigned int core;
+	int ret;
+
+	guard(mutex)(&ps5_cpufreq_lock);
+	if (!!state == ps5_mp1_boost_enabled())
+		return 0;
+
+	if (state) {
+		/* Every core to P0 first, then boost: no core stuck at a remapped state. */
+		ret = ps5_mp1_request_core_pstate(0xff, 0);
+		if (ret)
+			return ret;
+		memset(ps5_core_sent, 0, sizeof(ps5_core_sent));
+		return ps5_mp1_set_boost(true);
+	}
+
+	ret = ps5_mp1_set_boost(false);
+	if (ret)
+		return ret;
+	/* Leaving boost: re-apply what the governors asked for. */
+	memset(ps5_core_sent, -1, sizeof(ps5_core_sent));
+	for (core = 0; core < PS5_NUM_CORES; core++)
+		ps5_send_pstate(core, ps5_core_want[core]);
+	return 0;
+}
+
+static struct cpufreq_driver ps5_cpufreq_driver = {
+	.name		= "ps5-cpufreq",
+	.flags		= CPUFREQ_CONST_LOOPS,
+	.verify		= cpufreq_generic_frequency_table_verify,
+	.target_index	= ps5_cpufreq_target_index,
+	.get		= ps5_cpufreq_get,
+	.init		= ps5_cpufreq_init,
+	.set_boost	= ps5_cpufreq_set_boost,
+};
+
+static void ps5_sync_boost_flag(void)
+{
+	WRITE_ONCE(ps5_cpufreq_driver.boost_enabled, ps5_mp1_boost_enabled());
+}
+
+static int __init ps5_cpufreq_module_init(void)
+{
+	unsigned int i, n = 0;
+	u64 def;
+
+	if (boot_cpu_data.x86_vendor != X86_VENDOR_AMD || boot_cpu_data.x86 != 0x17 ||
+	    boot_cpu_data.x86_model != 0x46)
+		return -ENODEV;
+
+	/* P0 first: index order = P-state number. */
+	for (i = 0; i < PS5_NUM_PSTATES; i++) {
+		if (rdmsrq_safe(MSR_PSTATE_DEF_BASE + i, &def) || !(def & BIT_ULL(63)))
+			continue;
+		ps5_freq_table[n].frequency = pstate_khz(def);
+		ps5_freq_table[n].driver_data = i;
+		if (!ps5_freq_table[n].frequency)
+			continue;
+		pr_info("P%u: %u MHz\n", i, ps5_freq_table[n].frequency / 1000);
+		n++;
+	}
+	if (!n)
+		return -ENODEV;
+	ps5_freq_table[n].frequency = CPUFREQ_TABLE_END;
+
+	memset(ps5_core_sent, -1, sizeof(ps5_core_sent));
+	ps5_cpufreq_driver.boost_enabled = ps5_mp1_boost_enabled();
+	return cpufreq_register_driver(&ps5_cpufreq_driver);
+}
+
+static void __exit ps5_cpufreq_module_exit(void)
+{
+	bool boost;
+
+	cpufreq_unregister_driver(&ps5_cpufreq_driver);
+
+	/* Leave every core at full clock, and boost as it was. */
+	mutex_lock(&ps5_cpufreq_lock);
+	boost = ps5_mp1_boost_enabled();
+	ps5_mp1_request_core_pstate(0xff, 0);
+	if (boost)
+		ps5_mp1_set_boost(true);
+	mutex_unlock(&ps5_cpufreq_lock);
+}
+
+module_init(ps5_cpufreq_module_init);
+module_exit(ps5_cpufreq_module_exit);
+
+MODULE_DESCRIPTION("PlayStation 5 CPU frequency driver");
+MODULE_LICENSE("GPL");
